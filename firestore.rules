rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isHost(roomId) {
      return signedIn() &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid == request.auth.uid;
    }
    match /rooms/{roomId} {
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn() && resource.data.hostUid == request.auth.uid;
      match /players/{playerId} {
        allow read: if signedIn();
        allow create: if signedIn() && playerId == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() &&
          (playerId == request.auth.uid || isHost(roomId));
      }
    }
  }
}